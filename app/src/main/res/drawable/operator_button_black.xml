<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow/Glow effect -->
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#33FF5252" /> <!-- Semi-transparent red for glow -->
        </shape>
    </item>

    <!-- Main Background -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <solid android:color="#000000" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FF5252" />
        </shape>
    </item>
</layer-list>

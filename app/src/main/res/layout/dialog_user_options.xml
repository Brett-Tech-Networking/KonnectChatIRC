<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/options_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_users"
            android:padding="8dp"
            android:background="@drawable/circle_badge"
            android:backgroundTint="@color/lightblue" />

        <TextView
            android:id="@+id/options_nick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nickname"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/options_host_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Host: N/A"
            android:textSize="12sp"
            android:textColor="#AAAAAA" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Actions Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary Actions -->
            <Button
                android:id="@+id/btnPrivateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Message User"
                android:textAllCaps="false"
                android:background="@drawable/button_option_bg"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_switcher"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawablePadding="12dp"
                android:textColor="@color/white"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSlap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Slap User"
                android:textAllCaps="false"
                android:background="@drawable/button_option_bg"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:layout_marginBottom="16dp" />

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channel Management"
                android:textColor="@color/lightblue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnOp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Op"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#4CAF50" />

                <Button
                    android:id="@+id/btnDeop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="Deop"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#FF9800" />
            </GridLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <Button
                    android:id="@+id/btnKick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Kick"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#F44336" />

                <Button
                    android:id="@+id/btnBan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="Ban"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#F44336" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

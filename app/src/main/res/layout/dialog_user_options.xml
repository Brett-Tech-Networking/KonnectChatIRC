<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/options_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_users"
            android:padding="8dp"
            android:background="@drawable/circle_badge"
            android:backgroundTint="@color/lightblue" />

        <TextView
            android:id="@+id/options_nick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nickname"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <!-- Details Section (Left-Aligned) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginTop="12dp"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/options_host_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Host: N/A"
                android:textSize="12sp"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/options_ident"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ident: N/A"
                android:textSize="12sp"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/options_realname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real Name: N/A"
                android:textSize="12sp"
                android:textColor="#AAAAAA" />

            <TextView
                android:id="@+id/options_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: N/A"
                android:textSize="12sp"
                android:textColor="#AAAAAA" />

            <!-- Duplicate User Tag Section -->
            <LinearLayout
                android:id="@+id/layout_dup_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dup User"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/rect_badge_orange"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/options_dup_nicks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nick1, nick2"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="#AAAAAA"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Actions Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary Actions -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnPrivateMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Message"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnWhois"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="Whois"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="@color/white" />
            </GridLayout>

            <Button
                android:id="@+id/btnSlap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Slap User"
                android:textAllCaps="false"
                android:background="@drawable/button_option_bg"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:layout_marginBottom="16dp" />

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Channel Management"
                android:textColor="@color/lightblue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnOp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Op"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#4CAF50" />

                <Button
                    android:id="@+id/btnDeop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="Deop"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#FF9800" />
            </GridLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnVoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Voice"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#FDD835" />

                <Button
                    android:id="@+id/btnDevoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="Devoice"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#AAAAAA" />
            </GridLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <Button
                    android:id="@+id/btnKick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Kick"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#F44336" />

                <Button
                    android:id="@+id/btnBan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="Ban"
                    android:textAllCaps="false"
                    android:background="@drawable/button_option_bg"
                    app:backgroundTint="@null"
                    android:textColor="#F44336" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

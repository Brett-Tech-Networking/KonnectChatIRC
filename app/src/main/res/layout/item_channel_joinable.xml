<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Channel Icon (#) -->
    <TextView
        android:id="@+id/channel_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="#"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/circle_badge"
        android:backgroundTint="@color/lightblue"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true" />

    <!-- Star Icon (Top Right) -->
    <TextView
        android:id="@+id/channel_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐"
        android:textSize="20sp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:visibility="gone" />

    <!-- Channel Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/channel_icon"
        android:layout_toStartOf="@id/channel_star"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <!-- Channel Name -->
        <TextView
            android:id="@+id/channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#general"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <!-- User Count -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_users"
                android:tint="#AAAAAA"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/channel_user_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42 users"
                android:textSize="13sp"
                android:textColor="#AAAAAA" />
        </LinearLayout>

        <!-- Channel Description -->
        <TextView
            android:id="@+id/channel_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to the general channel"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="6dp"
            android:maxLines="4"
            android:lineSpacingMultiplier="1.1"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>

<!-- hover_panel.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/dialog_background"
        android:padding="16dp"
        android:elevation="8dp">

        <!-- Title Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMAND CONSOLE"
                android:textColor="#4FC3F7"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"
                android:letterSpacing="0.1"/>
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nickserv Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NICKSERV SERVICES"
                     android:textColor="#C5B0B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnNick"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CHANGE NICK"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnIdent"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IDENTIFY"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnNickRegister"
                    style="@style/CustomButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REGISTER NICKNAME"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FFFFFF"
                    android:layout_marginVertical="16dp"/>

                <!-- Chanserv Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHANSERV SERVICES"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnJoin"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="JOIN CHANNEL"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnChanRegister"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="REGISTER CHAN"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnOP"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OP USER"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnDEOP"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DEOP USER"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnSOP"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ADD SOP"
                        android:enabled="false"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnAOP"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ADD AOP"
                        android:enabled="false"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FFFFFF"
                    android:layout_marginVertical="16dp"/>

                <!-- Moderation Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHANNEL MODERATION"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnKick"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="KICK USER"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnBan"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BAN USER"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnUnban"
                    style="@style/CustomButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UNBAN HOST/NICK"
                    android:visibility="visible"/>

            </LinearLayout>
        </ScrollView>

        <!-- Fancy Operator Button - Right Aligned and Sleek -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOperator"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="OP CONSOLE"
            android:textColor="#FF5252"
            android:background="@drawable/operator_button_black"
            android:layout_marginTop="16dp"
            android:layout_gravity="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:drawableStart="@android:drawable/ic_lock_idle_lock"
            android:drawablePadding="4dp"
            android:drawableTint="#FF5252"
            android:elevation="6dp"
            android:backgroundTint="@android:color/transparent"/>

    </LinearLayout>
</FrameLayout>

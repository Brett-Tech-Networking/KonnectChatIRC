<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnChannelSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:scaleX="2"
            android:scaleY="2"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_switcher"
            android:contentDescription="Channel Switcher"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/unreadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@id/btnChannelSwitcher"
            android:layout_alignBottom="@id/btnChannelSwitcher"
            android:layout_marginEnd="-12dp"
            android:layout_marginBottom="-12dp"
            android:background="@drawable/circle_badge"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone"
            android:gravity="center"
            android:padding="4dp" />

        <TextView
            android:id="@+id/ChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channel Name"
            android:textColor="#FDD835"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="-15dp"
            android:layout_marginLeft="50dp"
            android:layout_alignParentTop="true"
            android:padding="12dp" />

        <TextView
            android:id="@+id/CurrentNick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Nick"
            android:textColor="#FDD835"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="-20dp"
            android:layout_marginLeft="54dp"
            android:layout_below="@id/ChannelName"
            android:padding="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@id/chatInputLayout"
            android:layout_below="@id/CurrentNick"
            android:background="#111111" />

        <RelativeLayout
            android:id="@+id/chatInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:padding="0dp">

            <ImageButton
                android:id="@+id/uploadButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_upload"
                android:contentDescription="Upload Image"
                app:tint="#FFFFFF"
                android:padding="8dp" />

            <EditText
                android:id="@+id/chatEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/uploadButton"
                android:layout_toStartOf="@id/sendButton"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_background"
                android:hint="Type a message"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:padding="12dp"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Send Message"
                android:padding="8dp"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <ImageButton
            android:id="@+id/adminButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="false"
            android:layout_toLeftOf="@id/btnUsers"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/admin_panel"
            android:scaleX="2"
            android:scaleY="2"
            android:layout_marginEnd="30dp"
            android:contentDescription="Admin Panel"
            android:padding="5dp"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:scaleX="1.8"
            android:scaleY="1.8"
            android:layout_margin="8dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_users"
            android:contentDescription="Users" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/left_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#222222"
        android:padding="0dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Settings"
            app:tint="#FFFFFF"
            android:padding="8dp" />

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:text="Disconnect"
            android:textColor="#FFFFFF"
            android:padding="4dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginEnd="0dp"/>

        <!-- Tab buttons for Channels and Private Messages -->
        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_below="@id/disconnectButton"
            android:orientation="horizontal"
            android:background="#2B2B2B"
            android:elevation="4dp">

            <Button
                android:id="@+id/btnChannelsTab"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="#️⃣ Channels"
                android:textColor="#FFFFFF"
                android:background="@drawable/tab_indicator_active"
                android:padding="12dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.5"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#555555" />

            <Button
                android:id="@+id/btnPrivateMessagesTab"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="💬 Messages"
                android:textColor="@color/tab_text_inactive"
                android:background="@drawable/tab_indicator"
                android:padding="12dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.5"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Channels Section -->
        <FrameLayout
            android:id="@+id/channelsSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tabContainer">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:background="#2B2B2B"
                android:clipToPadding="false" />
        </FrameLayout>

        <!-- Private Messages Section -->
        <FrameLayout
            android:id="@+id/privateMessagesSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tabContainer"
            android:visibility="gone">

            <ListView
                android:id="@+id/privateConversationListView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2B2B2B"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="vertical"
                android:cacheColorHint="@android:color/transparent" />
        </FrameLayout>
    </RelativeLayout>

    <ListView
        android:id="@+id/userListView"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:divider="@android:color/darker_gray"
        android:visibility="gone"
        android:dividerHeight="1dp" />
</androidx.drawerlayout.widget.DrawerLayout>

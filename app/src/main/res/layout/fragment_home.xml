<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_main_gradient">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo and Title centered at the top area -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/konnectchattrans"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/konnectchattrans"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konnect Chat IRC"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>

            <TextView
                android:id="@+id/subtitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your server. Your channel. Always connected."
                android:textColor="#B0FFFFFF"
                android:textSize="13sp"
                android:textStyle="italic"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Login Card -->
        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerLayout"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_centerHorizontal="true">

            <!-- Checkbox for desired nick -->
            <CheckBox
                android:id="@+id/nickCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I have a desired nick"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Nick/Pass Layout -->
            <LinearLayout
                android:id="@+id/nickPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/nickEditText"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Nickname"
                    android:textColor="@android:color/white"
                    android:textColorHint="#B0B0B0"
                    android:background="@drawable/bg_edit_text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Password (Optional)"
                    android:inputType="textPassword"
                    android:textColor="@android:color/white"
                    android:textColorHint="#B0B0B0"
                    android:background="@drawable/bg_edit_text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Server Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Server"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/serverSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edit_text"
                android:layout_marginBottom="16dp"/>

            <!-- Channel Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Channel"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/channelSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_edit_text"
                android:layout_marginBottom="16dp"/>

            <!-- Remember Me Checkbox -->
            <CheckBox
                android:id="@+id/rememberMeCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember me"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white"
                android:layout_marginBottom="16dp"
                android:checked="false"/>

            <!-- Join Button -->
            <Button
                android:id="@+id/joinButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="JOIN CHAT"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F2027"
                android:background="@drawable/bg_button_gradient"
                app:backgroundTint="@null"/>

        </LinearLayout>

        <!-- Tip -->
        <TextView
            android:id="@+id/tipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Tip: Long-press a server or channel to remove it"
            android:textColor="#50FFFFFF"
            android:textSize="11sp"
            android:layout_below="@id/loginCard"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"/>

        <!-- Credits -->
        <TextView
            android:id="@+id/Credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by Brett @ ThePlaceToChat"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:layout_below="@id/tipText"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

    </RelativeLayout>
</ScrollView>

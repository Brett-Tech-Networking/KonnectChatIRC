<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="64dp">

    <TextView
        android:id="@+id/convIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤"
        android:textSize="24sp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:id="@+id/conversationContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/convIcon"
        android:layout_toStartOf="@id/deleteConversationButton"
        android:orientation="vertical">

        <TextView
            android:id="@+id/convNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nickname"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/convPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message preview..."
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/deleteConversationButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Conversation"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:tint="#FF6B6B"
        android:focusable="false"
        android:clickable="true" />

    <View
        android:id="@+id/separator"
        android:layout_width="5dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="#FDD835"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3F3F3F"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
